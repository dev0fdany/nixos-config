# --- Positioning ---
anchor=top-right
margin=20

# --- Pill Shape Layout ---
width=350
height=100
border-radius=10
border-size=2
padding=15

# --- Catppuccin Mocha Color Scheme ---
background-color=#1B1B21
border-color=#595992

text-color=#cdd6f4ff

# --- Font & Text Formatting ---
font=sans-serif 11
text-alignment=left

# --- Behavior ---
default-timeout=5000
ignore-timeout=0

# --- Sound Notification ---
on-notify=exec mpv /etc/nixos/home/mako/notification-generic.wav
include=colors
